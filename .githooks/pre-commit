#!/usr/bin/env bash
# BuildFlow Pre-Commit Hook
# Auto-generated by 'buildflow precommit install'
# This hook runs BuildFlow in pre-commit mode before each commit
# Performance: budget=60s, max=2m

set -e

export GOEXPERIMENT=jsonv2
# The race detector requires cgo: outside "nix develop" CGO_ENABLED defaults
# to 0 on NixOS, and any race-bearing subprocess (doctor env/cgo-enabled
# check, test-race in non-blocklisted modes, user-added steps) fails bare
# with "go: -race requires cgo; enable cgo by setting CGO_ENABLED=1".
export CGO_ENABLED=1

echo "Running BuildFlow pre-commit checks (budget: 60s)..."

START=$(date +%s)

# CRITICAL: Verify the main binary compiles before anything else.
# This catches the entire class of wrong-package-path / undefined-symbol bugs
# (e.g. the analysis.Options -> stats.Options incident that sat broken in master
# for 3 sessions). The per-module loop below also catches this via go build ./...,
# but this explicit gate gives a clear, immediate error message and runs first.
# Cached builds are ~1s. Guarded by existence: only repos WITH ./cmd/buildflow
# (BuildFlow itself) run it; the template is installed fleet-wide and other
# repos do not have this directory.
if [ -d ./cmd/buildflow ]; then
    echo "Verifying main binary compiles (go build ./cmd/buildflow)..."
    go build ./cmd/buildflow || {
        echo "❌ BUILD GATE FAILED: go build ./cmd/buildflow"
        echo "   The main binary does not compile. Fix the error above before committing."
        exit 1
    }
fi

# Compile-check the workspace modules that THIS COMMIT touches.
# BuildFlow's pre-commit + --staged-only mode skips test steps, so a broken
# test file would otherwise slip through (the Phase E bug class). 'go build'
# catches broken production code; 'go vet' also type-checks test files.
# Scope is staged files, not the whole workspace: measured 2026-10-28, a
# 34-module workspace made this loop the single largest cost of a commit (362 s
# for one docs-only commit), which is the whole reason the lane exists. A module
# whose own files are not staged cannot have its compilation changed by this
# commit; the root module is always checked because it depends on every sibling
# and is cheap when cached.
if command -v go &>/dev/null; then
    STAGED_GOMODS=""

    if git diff --cached --quiet 2>/dev/null; then
        STAGED_GOMODS="./go.mod"
    else
        STAGED_GOMODS=$(
            git diff --cached --name-only |
                sed -e 's|/[^/]*$||' |
                awk '{ print }' |
                while IFS= read -r dir; do
                    while [ -n "$dir" ] && [ "$dir" != "." ]; do
                        if [ -f "$dir/go.mod" ]; then
                            echo "$dir/go.mod"
                            break
                        fi
                        dir=$(dirname "$dir")
                    done
                done
        ) | sort -u

        if [ -z "$STAGED_GOMODS" ] && [ -f ./go.mod ]; then
            STAGED_GOMODS="./go.mod"
        fi
    for gomod in $STAGED_GOMODS; do
        (
            cd "$(dirname "$gomod")"
            go build ./...
            go vet ./...
        )
    done
    fi
fi

# Run the repo-wide audit gate (em-dash ratchet, banned-symbol guards, dead
# Ginkgo suite detection, flag-default CHANGELOG guard). ~0.5s. This is what
# stops auto-commits from landing ratchet regressions that the full test gate
# would catch too late. Guarded by existence: the audit suite lives in
# BuildFlow's own repo; other repos skip silently.
if [ -d ./audit ]; then
    go test ./audit/ -count=1
fi

# Doc consistency gate (T2): provider/module count claims, cross-refs, and
# gotcha anchors verified against the live registry. Blocking so doc drift
# can never land (the 110-vs-111 drift survived because this was optional).
# Prefer the binary in the repo root (what repos with ./cmd/buildflow just
# built at the top of this hook) over the PATH-installed one: an installed
# release whose compiled-in registry count differs from the current tree
# reds every commit with a false provider count (observed 2026-11-02,
# plan M27).
if [ -x ./buildflow ]; then
    ./buildflow docs --check
elif command -v buildflow &>/dev/null; then
    buildflow docs --check
fi

# Stash unstaged changes so --fix only modifies staged files.
# This prevents the infinite auto-fix loop where each commit triggers --fix
# which modifies non-staged files which then need to be committed again.
STASHED=0
if ! git diff --quiet; then
    git stash push --keep-index --include-untracked -m "buildflow-pre-commit" || true
    STASHED=1
fi

# Run buildflow in pre-commit mode with performance budget. Same
# stale-binary discipline as the docs gate: repos that just built ./buildflow
# must gate against THAT binary, not a possibly older installed one.
if [ -x ./buildflow ]; then
    ./buildflow --build-mode pre-commit --staged-only
else
    buildflow --build-mode pre-commit --staged-only
fi

# Re-stage files that may have been modified by formatters
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$STAGED_FILES" ]; then
    echo "$STAGED_FILES" | xargs -r git add
fi

# Restore stashed changes
if [ "$STASHED" -eq 1 ]; then
    git stash pop || true
fi

END=$(date +%s)
DURATION=$((END-START))

echo "BuildFlow completed in ${DURATION}s"
